---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

type FigureVariant = "hero-16x9" | "story-4x3" | "catalog-4x3" | "detail-portrait" | "detail-landscape";

type Props = {
  readonly src: ImageMetadata;
  readonly alt: string;
  readonly caption: string;
  readonly variant: FigureVariant;
  readonly eager?: boolean;
};

const { src, alt, caption, variant, eager = false } = Astro.props;
---

<figure class="figure">
  <div class:list={["figure-media", `figure-media--${variant}`]}>
    <Image
      src={src}
      alt={alt}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      decoding="async"
    />
  </div>
  <figcaption>{caption}</figcaption>
</figure>
