---
import type { Brand } from "../data/keyboards";
import { resolveImage } from "../lib/images";
import { sitePath } from "../lib/urls";
import EditorialRibbon from "./EditorialRibbon.astro";
import Figure from "./Figure.astro";

type Props = {
  readonly brands: readonly Brand[];
};

const { brands }: Props = Astro.props;
const models = brands.flatMap((brand) =>
  brand.models.map((model) => ({ brandName: brand.name, model })),
);
---

<dialog class="model-dialog" aria-label="型号配色一览">
  {
    models.map(({ brandName, model }, modelIndex) => (
      <section
        class="model-dialog-panel"
        aria-labelledby={`model-dialog-${model.slug}-title`}
        data-model-dialog-panel
        hidden={modelIndex !== 0}
      >
        <header class="model-dialog-header">
          <EditorialRibbon label={`${brandName} / MODEL`} />
          <h2 id={`model-dialog-${model.slug}-title`}>{model.name}</h2>
          <p>{model.summary}</p>
        </header>

        <div class="model-dialog-toolbar">
          <button class="model-dialog-control" type="button" data-model-dialog-close>关闭</button>
          <a class="model-dialog-fullpage-link" href={sitePath(`/gallery/${model.slug}/`)}>
            查看完整型号页与放大图片
          </a>
        </div>

        <div class="model-dialog-colors">
          {model.colors.map((color, colorIndex) => (
            <section
              class="model-dialog-color"
              aria-labelledby={`model-dialog-${model.slug}-${color.slug}-title`}
              data-model-dialog-color
            >
              <header class="model-dialog-color-heading">
                <p class="kicker">COLOR {String(colorIndex + 1).padStart(2, "0")}</p>
                <h3 id={`model-dialog-${model.slug}-${color.slug}-title`}>{color.name}</h3>
                <p>{color.images.length} 个轴体／官方版本</p>
              </header>
              <div class="model-dialog-figures">
                {color.images.map((image) => (
                  <div class="model-dialog-figure">
                    <p class="kicker model-dialog-variant">{image.variant ?? color.name}</p>
                    <Figure
                      src={resolveImage(image.asset)}
                      alt={image.alt}
                      caption={image.caption}
                      variant="catalog-4x3"
                    />
                  </div>
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>
    ))
  }
</dialog>

<script>
  class BrandCatalog extends HTMLElement {
    connectedCallback(): void {
      const dialog = this.querySelector("dialog.model-dialog");
      const brandSections = Array.from(this.querySelectorAll<HTMLDetailsElement>("details[data-brand-section]"));
      const modelLinks = Array.from(this.querySelectorAll<HTMLAnchorElement>("[data-model-link]"));
      const panels = Array.from(this.querySelectorAll<HTMLElement>("[data-model-dialog-panel]"));

      if (!(dialog instanceof HTMLDialogElement) || panels.length === 0) return;

      let opener: HTMLAnchorElement | null = null;

      const showPanel = (index: number): boolean => {
        const activePanel = panels.at(index);
        if (!activePanel) return false;

        panels.forEach((panel) => {
          panel.hidden = panel !== activePanel;
        });
        dialog.scrollTop = 0;
        if (!dialog.open) dialog.showModal();

        const closeButton = activePanel.querySelector("[data-model-dialog-close]");
        if (closeButton instanceof HTMLButtonElement) closeButton.focus();
        return true;
      };

      modelLinks.forEach((modelLink) => {
        modelLink.addEventListener("click", (event) => {
          const indexValue = modelLink.dataset["modelIndex"];
          if (indexValue === undefined) return;

          const index = Number.parseInt(indexValue, 10);
          if (!Number.isInteger(index) || !showPanel(index)) return;

          event.preventDefault();
          opener = modelLink;
        });
      });

      this.querySelectorAll<HTMLButtonElement>("[data-model-dialog-close]").forEach((closeButton) => {
        closeButton.addEventListener("click", () => dialog.close());
      });

      dialog.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        event.preventDefault();
        dialog.close();
      });

      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });

      dialog.addEventListener("close", () => {
        opener?.focus();
        opener = null;
      });

      const openHashedBrand = (): void => {
        if (!window.location.hash.startsWith("#brand-")) return;
        const target = document.getElementById(window.location.hash.slice(1));
        if (!(target instanceof HTMLDetailsElement) || !this.contains(target)) return;
        brandSections.forEach((section) => {
          section.open = section === target;
        });
      };

      openHashedBrand();
      window.addEventListener("hashchange", openHashedBrand);
    }
  }

  if (!customElements.get("brand-catalog")) customElements.define("brand-catalog", BrandCatalog);
</script>
