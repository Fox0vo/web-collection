---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

export type LightboxItem = {
  readonly src: ImageMetadata;
  readonly alt: string;
  readonly caption: string;
  readonly label: string;
  readonly buttonLabel?: string;
};

type Props = {
  readonly items: readonly LightboxItem[];
  readonly label?: string;
  readonly priority?: boolean;
};

const { items, label = "产品图像浏览器", priority = false } = Astro.props;
const responsiveWidths = [320, 480, 640, 800, 1120, 1600, 2240, 3360, 4480];
const responsiveSizes = "(min-width: 1152px) 1072px, calc(100vw - 32px)";
const responsiveQuality = 90;
---

<light-box>
  <div class="lightbox-grid">
    {
      items.map((item, index) => (
        <button
          class="lightbox-trigger"
          type="button"
          aria-label={item.buttonLabel ?? `${item.label} · 放大查看`}
          data-lightbox-trigger
          data-index={index}
        >
          <span class="lightbox-trigger-media" data-lightbox-source>
            <Image
              src={item.src}
              alt={item.alt}
              widths={responsiveWidths}
              sizes={responsiveSizes}
              quality={responsiveQuality}
              loading={priority && index === 0 ? "eager" : "lazy"}
              fetchpriority={priority && index === 0 ? "high" : "auto"}
              decoding="async"
              style={`--lightbox-source-width: ${item.src.width}px; --lightbox-source-height: ${item.src.height}px`}
            />
          </span>
          <span class="lightbox-label">{item.label}</span>
          <span class="lightbox-action" aria-hidden="true">放大查看</span>
        </button>
      ))
    }
  </div>

  <dialog class="lightbox-dialog" aria-label={label}>
    <div aria-live="polite">
      {
        items.map((item) => (
          <section class="lightbox-panel" data-lightbox-panel hidden>
            <figure>
              <div class="lightbox-dialog-media" data-lightbox-destination></div>
              <figcaption>{item.caption}</figcaption>
            </figure>
          </section>
        ))
      }
    </div>
    <div class="lightbox-toolbar">
      <button class="lightbox-control" type="button" data-lightbox-previous>上一张</button>
      <button class="lightbox-control" type="button" data-lightbox-close>关闭</button>
      <button class="lightbox-control" type="button" data-lightbox-next>下一张</button>
    </div>
  </dialog>
</light-box>

<script>
  class LightBox extends HTMLElement {
    connectedCallback(): void {
      const dialog = this.querySelector("dialog");
      const closeButton = this.querySelector("[data-lightbox-close]");
      const previousButton = this.querySelector("[data-lightbox-previous]");
      const nextButton = this.querySelector("[data-lightbox-next]");
      const sourceSlots = Array.from(this.querySelectorAll("[data-lightbox-source]")).filter(
        (element) => element instanceof HTMLElement,
      );
      const images = Array.from(this.querySelectorAll("[data-lightbox-source] > img")).filter(
        (element) => element instanceof HTMLImageElement,
      );
      const destinations = Array.from(this.querySelectorAll("[data-lightbox-destination]")).filter(
        (element) => element instanceof HTMLElement,
      );
      const triggers = Array.from(this.querySelectorAll("[data-lightbox-trigger]")).filter(
        (element) => element instanceof HTMLButtonElement,
      );
      const panels = Array.from(this.querySelectorAll("[data-lightbox-panel]")).filter(
        (element) => element instanceof HTMLElement,
      );
      const itemCount = panels.length;

      if (
        !(dialog instanceof HTMLDialogElement) ||
        !(closeButton instanceof HTMLButtonElement) ||
        !(previousButton instanceof HTMLButtonElement) ||
        !(nextButton instanceof HTMLButtonElement) ||
        itemCount === 0 ||
        sourceSlots.length !== itemCount ||
        images.length !== itemCount ||
        destinations.length !== itemCount ||
        triggers.length !== itemCount
      ) return;

      let currentIndex: number | null = null;
      let opener: HTMLButtonElement | null = null;

      const parkMountedImage = (): void => {
        if (currentIndex === null) return;
        const image = images.at(currentIndex);
        const sourceSlot = sourceSlots.at(currentIndex);
        const panel = panels.at(currentIndex);
        if (!image || !sourceSlot || !panel) return;

        sourceSlot.append(image);
        panel.hidden = true;
        currentIndex = null;
      };

      const show = (index: number): boolean => {
        const nextIndex = (index + itemCount) % itemCount;
        const image = images.at(nextIndex);
        const destination = destinations.at(nextIndex);
        const panel = panels.at(nextIndex);
        if (!image || !destination || !panel) return false;

        const sourceWidth = Number.parseFloat(image.style.getPropertyValue("--lightbox-source-width"));
        const sourceHeight = Number.parseFloat(image.style.getPropertyValue("--lightbox-source-height"));
        image.style.setProperty("--lightbox-display-max-inline-size", `${sourceWidth / window.devicePixelRatio}px`);
        image.style.setProperty("--lightbox-display-max-block-size", `${sourceHeight / window.devicePixelRatio}px`);

        parkMountedImage();
        destination.append(image);
        panel.hidden = false;
        currentIndex = nextIndex;
        return true;
      };

      triggers.forEach((trigger) => {
        trigger.addEventListener("click", () => {
          const indexValue = trigger.dataset["index"];
          if (indexValue === undefined) return;
          const index = Number.parseInt(indexValue, 10);
          if (!Number.isInteger(index)) return;

          opener = trigger;
          if (!show(index)) {
            opener = null;
            return;
          }
          dialog.showModal();
          closeButton.focus();
        });
      });

      previousButton.addEventListener("click", () => {
        if (currentIndex !== null) show(currentIndex - 1);
      });
      nextButton.addEventListener("click", () => {
        if (currentIndex !== null) show(currentIndex + 1);
      });
      closeButton.addEventListener("click", () => dialog.close());

      dialog.addEventListener("keydown", (event) => {
        if (currentIndex === null) return;
        if (event.key === "ArrowLeft") show(currentIndex - 1);
        if (event.key === "ArrowRight") show(currentIndex + 1);
      });

      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });

      dialog.addEventListener("close", () => {
        parkMountedImage();
        opener?.focus();
        opener = null;
      });
    }
  }

  if (!customElements.get("light-box")) customElements.define("light-box", LightBox);
</script>
