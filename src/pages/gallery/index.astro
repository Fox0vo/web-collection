---
import EditorialRibbon from "../../components/EditorialRibbon.astro";
import Figure from "../../components/Figure.astro";
import ModelDialog from "../../components/ModelDialog.astro";
import { allModels, brands, colorVariantCount } from "../../data/keyboards";
import { resolveImage } from "../../lib/images";
import { sitePath } from "../../lib/urls";
import BaseLayout from "../../layouts/BaseLayout.astro";

const modelIndices: ReadonlyMap<string, number> = new Map(
  allModels.map((model, index) => [model.slug, index] as const),
);
---

<BaseLayout
  title="键盘目录｜Web Collection"
  description={`按 SKN、迈从 MCHOSE、EPOMAKER 与 VGN 浏览 ${allModels.length} 组键盘型号和 ${colorVariantCount} 组真实配色。`}
>
  <header class="frame page-intro">
    <EditorialRibbon label="KEYBOARD SHOWCASE / 键盘图库" />
    <h1 class="page-title"><span>挑选品牌，</span><br /><span>浏览每一款配色。</span></h1>
    <p class="lead">展开品牌并选择型号，浏览完整配色与<span class="nowrap">轴体版本</span>；点击卡片即可查看<span class="nowrap">每张产品正面图</span>。</p>
  </header>

  <brand-catalog>
    <div class="frame brand-catalog">
      {
        brands.map((brand, brandIndex) => (
          <details
            id={`brand-${brand.slug}`}
            class="brand-accordion"
            aria-labelledby={`brand-${brand.slug}-title`}
            data-brand-section
          >
            <summary class="brand-summary-row">
              <span class="brand-summary-ribbon">
                BRAND {String(brandIndex + 1).padStart(2, "0")}
              </span>
              <span
                id={`brand-${brand.slug}-title`}
                class="brand-summary-title"
                role="heading"
                aria-level="2"
              >
                {brand.name}
              </span>
              <span class="brand-summary-count">{brand.models.length} 组型号</span>
            </summary>

            <ol class="model-list">
              {brand.models.map((model) => {
                const representative = model.colors[0].images[0];
                const imageCount = model.colors.reduce((total, color) => total + color.images.length, 0);
                const modelIndexValue = modelIndices.get(model.slug);
                if (modelIndexValue === undefined) return null;

                return (
                  <li>
                    <a
                      class="model-entry"
                      href={sitePath(`/gallery/${model.slug}/`)}
                      data-model-link
                      data-model-index={modelIndexValue}
                    >
                      <Figure
                        src={resolveImage(representative.asset)}
                        alt={representative.alt}
                        caption={representative.caption}
                        variant="catalog-4x3"
                      />
                      <span class="model-entry-copy">
                        <span class="model-entry-title" role="heading" aria-level="3">{model.name}</span>
                        <span class="kicker">{brand.name}</span>
                        <span class="model-entry-summary">
                          共 {model.colors.length} 组配色，{imageCount} 张产品正面图。
                        </span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ol>
          </details>
        ))
      }
    </div>
    <ModelDialog brands={brands} />
  </brand-catalog>
</BaseLayout>
