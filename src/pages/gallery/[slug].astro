---
import EditorialRibbon from "../../components/EditorialRibbon.astro";
import Figure from "../../components/Figure.astro";
import OutlineButton from "../../components/OutlineButton.astro";
import StoryTile from "../../components/StoryTile.astro";
import TagList from "../../components/TagList.astro";
import { products, type Product } from "../../data/products";
import { sitePath } from "../../lib/urls";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

type Props = {
  readonly product: Product;
};

const { product }: Props = Astro.props;
const relatedProducts = products.filter((candidate) => candidate.slug !== product.slug).slice(0, 3);
---

<BaseLayout title={`${product.title}｜Web Collection`} description={`${product.subtitle}。${product.deck}`}>
  <article>
    <header class="frame detail-header">
      <div>
        <EditorialRibbon label={`${product.number} / ${product.category}`} />
        <h1 class="detail-title">{product.title}</h1>
        <p class="detail-subtitle">{product.subtitle}</p>
      </div>
      <dl class="detail-meta">
        <div><dt>年份</dt><dd>{product.year}</dd></div>
        <div><dt>制作</dt><dd>{product.maker}</dd></div>
        <div><dt>材料</dt><dd>{product.material}</dd></div>
        <div><dt>编号</dt><dd>WC-{product.number}</dd></div>
      </dl>
    </header>

    <div class="frame detail-figure">
      <Figure {...product.image} variant="detail-landscape" eager />
    </div>

    <div class="frame detail-story">
      <div class="detail-prose">
        <p class="kicker">OBJECT STORY / 物件故事</p>
        {product.story.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <aside class="detail-aside" aria-label="产品补充信息">
        <TagList tags={product.tags} />
        <OutlineButton href={sitePath("/gallery/")}>返回产品志</OutlineButton>
      </aside>
    </div>
  </article>

  <section class="frame related-stories" aria-labelledby="related-title">
    <EditorialRibbon label="CONTINUE / 继续阅读" />
    <h2 id="related-title" class="section-heading">同一期的其他物件。</h2>
    <div class="related-grid">
      {relatedProducts.map((related) => <StoryTile product={related} variant="compact" headingLevel="h3" />)}
    </div>
  </section>
</BaseLayout>
