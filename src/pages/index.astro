---
import EditorialRibbon from "../components/EditorialRibbon.astro";
import OutlineButton from "../components/OutlineButton.astro";
import StoryTile from "../components/StoryTile.astro";
import { brandCount, brands, colorVariantCount, modelCount } from "../data/keyboards";
import { resolveImage } from "../lib/images";
import { sitePath } from "../lib/urls";
import BaseLayout from "../layouts/BaseLayout.astro";

const leadModel = brands[1].models[0];
const leadImage = leadModel.colors[0].images[0];
const leadImageCount = leadModel.colors.reduce((count, color) => count + color.images.length, 0);
---

<BaseLayout
  title="Web Collection｜键盘品牌档案"
  description="按品牌、型号与配色整理的键盘收藏，从首页进入图库逐一浏览。"
>
  <section class="frame home-hero" aria-labelledby="home-title">
    <div>
      <EditorialRibbon label="KEYBOARD ARCHIVE / 键盘收藏" />
      <h1 id="home-title" class="display-title"><span>键盘，</span><br /><span>按品牌归档。</span></h1>
      <p class="lead">一处按品牌、型号与配色整理的<span class="nowrap">键盘收藏</span>。从这里走进图库，<span class="nowrap">逐把细看</span><span class="nowrap">它们的外观与配色</span>。</p>
    </div>
    <div>
      <p class="hero-note">{brandCount} 个品牌，{modelCount} 组型号，{colorVariantCount} 组配色。<span class="nowrap">每一把</span>都配有<span class="nowrap">正面图</span>，方便逐一对照。</p>
      <OutlineButton href={sitePath("/gallery/")}>浏览键盘图库</OutlineButton>
    </div>
  </section>

  <section class="frame page-section" aria-labelledby="feature-title">
    <EditorialRibbon label="FEATURED STORY / 本期精选" />
    <h2 id="feature-title" class="section-heading">从一把键盘开始，细看型号与配色。</h2>
    <StoryTile
      href={sitePath(`/gallery/${leadModel.slug}/`)}
      kicker={`${brands[1].name} / ${leadModel.colors.length} 组配色`}
      title={leadModel.name}
      deck={`收录 ${leadModel.colors.length} 组配色、${leadImageCount} 张正面图。`}
      image={{ src: resolveImage(leadImage.asset), alt: leadImage.alt, caption: leadImage.caption }}
      variant="lead"
      eager
    />
  </section>

  <section class="frame page-section" aria-labelledby="index-title">
    <EditorialRibbon label="BRAND INDEX / 品牌索引" />
    <h2 id="index-title" class="section-heading">按品牌翻阅这份键盘档案。</h2>
    <div class="home-index">
      {
        brands.map((brand) => (
          <article class="brand-summary">
            <p class="kicker">{brand.models.length} 组型号</p>
            <h3>{brand.name}</h3>
            <a class="text-link" href={sitePath(`/gallery/#brand-${brand.slug}`)}>查看品牌型号</a>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
